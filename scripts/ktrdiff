#!/bin/sh
# KTRDiff CLI launcher (Linux/macOS/Git Bash): runs the single-file Node bundle (Node 22+).
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CLI="$SCRIPT_DIR/../packages/cli/dist/ktrdiff.mjs"
if [ ! -f "$CLI" ]; then
  echo "ktrdiff: $CLI not found; build it first: npm run build:cli" >&2
  exit 2
fi
exec node "$CLI" "$@"
